# Copy this file to .env and set EXPO_PUBLIC_API_URL to the API origin.
#
# Local dev (physical devices on your LAN): your dev machine's LAN IP.
#   Find it with: ip addr show | grep 'inet ' | grep -v 127.0.0.1
EXPO_PUBLIC_API_URL=http://192.168.1.23:8080
#
# Against the deployed server: the public HTTPS origin, no trailing
# slash, no /api suffix. The Render deployment (see render.yaml) is:
#   EXPO_PUBLIC_API_URL=https://mu3ic-api.onrender.com
# render.yaml already bakes this into the mu3ic-web static build; you
# only need it here for a native `expo run` or an EAS build.
