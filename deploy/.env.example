# Copy to .env, fill in, and `chmod 600 .env`. Never commit .env.
# Generate secrets:
#   openssl rand -hex 32     # JWT_SECRET
#   openssl rand -hex 24     # REGISTRATION_INVITE_CODE
#   openssl rand -base64 30  # POSTGRES_PASSWORD

# --- Public site -------------------------------------------------------
# The hostname the app is served from (no scheme). Must have a DNS record
# pointing at this host for Caddy to get a TLS cert.
SITE_ADDRESS=music.example.com
# Email for Let's Encrypt expiry notices (optional but recommended).
ACME_EMAIL=you@example.com

# --- Database --------------------------------------------------------
POSTGRES_USER=mu3ic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mu3ic

# --- Auth -----------------------------------------------------------
# Required. Server refuses to start if unset, the dev default, or < 32 chars.
JWT_SECRET=change-me-to-openssl-rand-hex-32
# Registration is closed by default: the first account can still be
# created (bootstrap), after which a matching invite code is required.
REGISTRATION_OPEN=false
REGISTRATION_INVITE_CODE=change-me-or-leave-blank-to-fully-close-after-first-user

# --- Object storage (Cloudflare R2, S3 API) ---------------------------
# Full S3 API endpoint for your account.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=mu3ic-audio
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me

# --- Tuning (optional) ----------------------------------------------
# Lifetime of presigned stream/artwork URLs.
STREAM_URL_TTL=15m
